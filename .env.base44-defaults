# Local dev placeholders — the app boots without external credentials.
# Real secrets delivered via /run/base44/app.env always override these.

# JWT signing secret (used by the API auth middleware). Override with the real
# SESSION_SECRET to keep existing user sessions valid against the production DB.
SESSION_SECRET=base44-dev-session-secret-change-me

# Secret protecting the Layerbase heartbeat endpoint (GET /api/health/layerbase).
# Override with a strong random string via /run/base44/app.env.
CRON_HEARTBEAT_SECRET=base44-dev-cron-heartbeat-secret-change-me

# Telegram Local Bot API Server URL (optional). When set, the Telegram client
# uses this instead of https://api.telegram.org, lifting the getFile limit from
# 20 MB to 2 GB. No extra credentials needed — same bot token.
# Example: TELEGRAM_API_BASE=http://localhost:8081
# TELEGRAM_API_BASE=
